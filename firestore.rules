rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['customerName', 'plan', 'date', 'status', 'amount']) &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100 &&
             data.plan in ['Basic', 'Pro', 'Premium', 'Enterprise'] &&
             data.date is string && data.date.size() <= 30 &&
             data.status in ['Active', 'Pending', 'Canceled'] &&
             data.amount is number && data.amount >= 0;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 120;
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(subscriptionId) && isValidSubscription(incoming());
      allow update: if isSignedIn() && isValidId(subscriptionId) && isValidSubscription(incoming());
      allow delete: if isSignedIn() && isValidId(subscriptionId);
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
